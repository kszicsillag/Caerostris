@namespace Caerostris.Shared.Data.Graphs


@inherits TrackSelectionGraph


@inject IStringLocalizer<Text> L


<SubsectionTitle Title=@L["AddedAtGraphTitle"] />

<div class="chart-container">
    <CartesianChart Series=@series
                     XAxes=@xAxes
                     LegendPosition=@LegendPosition.Right />
</div>


@code
{
    private ISeries[] series = [];
    private ICartesianAxis[] xAxes = [];

    private record MonthlyCount(int Year, int Month, int Count);

    protected override void OnInitialized()
    {
        xAxes = new ICartesianAxis[]
        {
            new Axis
            {
                Name = L["MonthOfYear"],
                MinStep = 1
            }
        };

        series = Tracks
            .GroupBy(t => t.AddedAt.Year)
            .OrderBy(g => g.Key)
            .Select(yearGroup =>
            {
                var points = yearGroup
                    .GroupBy(t => t.AddedAt.Month)
                    .OrderBy(g => g.Key)
                    .Select(g => new MonthlyCount(yearGroup.Key, g.Key, g.Count()))
                    .ToArray();

                var columnSeries = new ColumnSeries<MonthlyCount>
                {
                    Name = yearGroup.Key.ToString(),
                    Values = points,
                    Mapping = (p, _) => new(p.Month, p.Count),
                    YToolTipLabelFormatter = point =>
                        $"{WebApiModelExtensions.HumanReadableMonth(point.Model!.Month)} {point.Model.Year}: {point.Model.Count} {L["NumSavedTracks"]}"
                };

                columnSeries.ChartPointPointerDown += async (_, point) => await OnMonthSelected(point.Model!);

                return (ISeries)columnSeries;
            })
            .ToArray();
    }

    private async Task OnMonthSelected(MonthlyCount month)
    {
        SelectedTracksAndDescription = new
        (
            Tracks.Where(t => t.AddedAt.Year == month.Year && t.AddedAt.Month == month.Month),
            L["SongsYouSavedIn", WebApiModelExtensions.HumanReadableMonth(month.Month), month.Year]!
        );

        await OnSelectedTracksAndDescriptionChanged();
    }
}
