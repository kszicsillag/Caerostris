@namespace Caerostris.Shared.Data.Graphs


@inherits TrackSelectionGraph


@inject IStringLocalizer<Text> L


<SubsectionTitle Title=@L["TrackLengthGraphTitle"] />

<div class="chart-container">
    <CartesianChart Series=@series
                     XAxes=@xAxes />
</div>


@code
{
    private ISeries[] series = [];
    private ICartesianAxis[] xAxes = [];

    private record MinuteBucket(int Minute, int Count);

    protected override void OnInitialized()
    {
        var buckets = Tracks
            .GroupBy(DurationToFloorMinutes)
            .OrderBy(g => g.Key)
            .Select(g => new MinuteBucket(g.Key, g.Count()))
            .ToArray();

        xAxes = new ICartesianAxis[]
        {
            new Axis
            {
                Labeler = value => FormatInterval((int)value),
                MinStep = 1
            }
        };

        var columnSeries = new ColumnSeries<MinuteBucket>
        {
            Values = buckets,
            Mapping = (b, _) => new(b.Minute, b.Count),
            DataLabelsPaint = new SolidColorPaint(SKColors.White),
            DataLabelsPosition = DataLabelsPosition.Top,
            YToolTipLabelFormatter = point => $"{FormatInterval(point.Model!.Minute)}: {point.Model.Count} {L["NumSavedTracks"]}"
        };

        columnSeries.ChartPointPointerDown += async (_, point) => await OnIntervalSelected(point.Model!.Minute);

        series = new ISeries[] { columnSeries };
    }

    private static int DurationToFloorMinutes(SavedTrack s) =>
        TimeSpan.FromMilliseconds(s.Track.DurationMs).Minutes;

    private static string FormatInterval(int min) =>
        $"{min}-{min + 1} min";

    private async Task OnIntervalSelected(int minute)
    {
        SelectedTracksAndDescription = new
        (
            Tracks.Where(s => DurationToFloorMinutes(s) == minute),
            L["SongsWithADurationOf", FormatInterval(minute)]!
        );

        await OnSelectedTracksAndDescriptionChanged();
    }
}
