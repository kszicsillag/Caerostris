@namespace Caerostris.Shared.Data.Graphs


@inherits TrackSelectionGraph


@inject IStringLocalizer<Text> L


<SubsectionTitle Title=@L["AudioFeaturesGraphTitle"] />

<div class="chart-container">
    <CartesianChart Series=@series
                     XAxes=@xAxes
                     YAxes=@yAxes
                     LegendPosition=@LegendPosition.Right />
</div>


@code
{
    [Parameter]
    public IEnumerable<TrackAudioFeatures> AudioFeatures { get; set; } = default!;


    private IEnumerable<(SavedTrack Track, TrackAudioFeatures Features)>? data;
    private MonthlyAudioFeatures[] monthly = [];
    private ISeries[] series = [];
    private ICartesianAxis[] xAxes = [];
    private ICartesianAxis[] yAxes = [];

    private const int BpmAxis = 0, NormAxis = 1;

    private record MonthlyAudioFeatures(int Index, string Month, float Tempo, float Acousticness, float Valence, float Danceability);


    protected override void OnInitialized()
    {
        data = Tracks
            .Join(AudioFeatures, s => s.Track.Id, a => a.Id, (s, a) => (Track: s, Features: a))
            .OrderBy(d => d.Track.AddedAt);

        monthly = data
            .GroupBy(d => d.Track.AddedAt.ToString("yyyy-MM", CultureInfo.InvariantCulture))
            .OrderBy(g => g.Key)
            .Select((g, index) => new MonthlyAudioFeatures(
                index,
                g.Key,
                g.Average(d => d.Features.Tempo),
                g.Average(d => d.Features.Acousticness),
                g.Average(d => d.Features.Valence),
                g.Average(d => d.Features.Danceability)))
            .ToArray();

        xAxes = new ICartesianAxis[]
        {
            new Axis { Labels = monthly.Select(m => m.Month).ToArray() }
        };

        yAxes = new ICartesianAxis[]
        {
            new Axis { Name = L["BeatsPerMinute"], Position = AxisPosition.Start },
            new Axis { Name = L["NormalizedScore"], Position = AxisPosition.End }
        };

        series = new ISeries[]
        {
            BuildLineSeries(nameof(TrackAudioFeatures.Tempo), m => m.Tempo, f => f.Tempo, BpmAxis),
            BuildLineSeries(nameof(TrackAudioFeatures.Acousticness), m => m.Acousticness, f => f.Acousticness, NormAxis),
            BuildLineSeries(nameof(TrackAudioFeatures.Valence), m => m.Valence, f => f.Valence, NormAxis),
            BuildLineSeries(nameof(TrackAudioFeatures.Danceability), m => m.Danceability, f => f.Danceability, NormAxis),
        };
    }

    private LineSeries<MonthlyAudioFeatures> BuildLineSeries(
        string name,
        Func<MonthlyAudioFeatures, float> monthlyValue,
        Func<TrackAudioFeatures, float> trackValue,
        int scalesYAt)
    {
        var lineSeries = new LineSeries<MonthlyAudioFeatures>
        {
            Name = name,
            Values = monthly,
            Mapping = (m, _) => new(m.Index, monthlyValue(m)),
            ScalesYAt = scalesYAt,
            GeometrySize = 0,
            YToolTipLabelFormatter = point => L["Around", name, GetFormattedFloat(monthlyValue(point.Model!))]!
        };

        lineSeries.ChartPointPointerDown += async (_, point) =>
            await OnValueSelected(name, monthlyValue(point.Model!), trackValue);

        return lineSeries;
    }

    private string GetFormattedFloat(float f) =>
        f.ToString("0.##");

    private async Task OnValueSelected(string property, float value, Func<TrackAudioFeatures, float> selector)
    {
        if (data is null)
            return;

        SelectedTracksAndDescription = new
        (
            data
                .Select(d => new { d.Track, Distance = Math.Abs(selector(d.Features) - value) })
                .OrderBy(d => d.Distance)
                .Take(25)
                .Select(d => d.Track),
            L["SongsWithPropertyAround", property.ToLowerInvariant(), GetFormattedFloat(value)]!
        );

        await OnSelectedTracksAndDescriptionChanged();
    }
}
