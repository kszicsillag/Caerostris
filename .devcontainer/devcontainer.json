{
  "name": "Caerostris",

  // The image itself (deliberately NOT pinned to the project's current
  // net6.0-preview TargetFramework - this devcontainer targets a current
  // .NET LTS so the eventual framework upgrade happens in a modern
  // toolchain, rather than reproducing the 2021-era preview SDK; re-check
  // this tag once Caerostris.csproj is migrated off net6.0) plus the
  // egress-caging Squid sidecar both live in docker-compose.yml now - see
  // .claude/sandbox-design.md for why. Plain version tag on the image (not
  // the "<generation>-<version>" compound form, e.g. "2-10.0") on purpose:
  // compound tags make Dependabot occasionally propose a lower runtime as
  // an "upgrade" because it misparses the generation prefix as part of the
  // version.
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/Caerostris",
  "remoteUser": "vscode",

  "features": {
    // gh is assumed available for any agent that files/reviews PRs or issues.
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Installs the Claude Code CLI itself, so every clone gets the same version
    // rather than whatever happens to be on the host.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // Base image only ships Node 18 (apt/NodeSource, not nvm-managed) - too old
    // for current MCP servers (e.g. @playwright/mcp requires Node >=20). This
    // feature installs an nvm-managed LTS on top and puts it first on PATH.
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  // Mounts and container-wide env (proxy vars, GIT_CONFIG_GLOBAL, etc.) now
  // live in docker-compose.yml's `devcontainer` service - compose is the
  // canonical place for both once a proxy sidecar is in the picture.

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Default Blazor WebAssembly / Kestrel dev ports (see Properties/launchSettings.json).
  "forwardPorts": [5000, 5001],
  "portsAttributes": {
    "5000": { "label": "Caerostris (HTTP)" },
    "5001": { "label": "Caerostris (HTTPS)" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
